# Runtime environment: development | production | test (default: development)
NODE_ENV=

# Port for the HTTP server to listen on (default: 3000)
PORT=

# Comma-separated list of allowed browser origins for CORS (e.g. http://localhost:5173,https://yourdomain.com)
FRONTEND_ORIGIN=

# Supabase project URL (e.g. https://your-project.supabase.co)
SUPABASE_URL=

# Supabase service role secret key (server-side only, bypasses RLS, never exposed)
SUPABASE_SECRET_KEY=

# Resend API key for outbound transactional email (starts with re_)
RESEND_API_KEY=

# Destination email address where contact form notifications are delivered
NOTIFY_EMAIL=

# Sender address shown on delivered email notifications (default: Portfolio Contact <onboarding@resend.dev>)
MAIL_FROM=

# Enable Swagger API documentation at /api/docs: true | false (default: true outside production, false in production)
ENABLE_SWAGGER=

# Google Gemini API key from Google AI Studio (starts with AIza...)
GEMINI_API_KEY=

# Gemini embedding model (default: gemini-embedding-001, outputDimensionality: 768)
GEMINI_EMBED_MODEL=gemini-embedding-001

# Gemini chat model (e.g. gemini-2.5-flash or gemini-1.5-flash)
GEMINI_CHAT_MODEL=gemini-3.8-flash
